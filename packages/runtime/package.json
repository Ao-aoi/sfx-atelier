{
  "name": "@sfx-atelier/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "sfx-bank を Web Audio で鳴らす再生ライブラリ（依存なし、gzip 後 10KB 以下）",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "vite build",
    "test": "vitest run && vitest run -c vitest.browser.config.ts",
    "test:node": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sfx-atelier/format": "*",
    "@vitest/browser-playwright": "^5.1.1",
    "playwright": "~1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "license": "MIT"
}
