{
  "name": "@sfx-atelier/fit",
  "version": "0.0.0",
  "private": true,
  "description": "波形 → 層（減衰する正弦波＋帯域雑音）への変換。エディタとツールだけが使い、ランタイムには入れない",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run && vitest run -c vitest.browser.config.ts",
    "test:node": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "typecheck": "tsc --noEmit",
    "measure": "vitest run -c vitest.browser.config.ts test/measure.browser.test.ts --silent=false"
  },
  "dependencies": {
    "@sfx-atelier/analysis": "*",
    "@sfx-atelier/format": "*"
  },
  "devDependencies": {
    "@sfx-atelier/runtime": "*",
    "@vitest/browser-playwright": "^5.1.1",
    "playwright": "~1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
