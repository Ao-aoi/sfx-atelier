{
  "name": "sfx-atelier",
  "private": true,
  "description": "web ゲーム向けの軽量な効果音・ジングル作成ツール",
  "workspaces": [
    "packages/*",
    "web",
    "analysis-demo",
    "functions",
    "mcp"
  ],
  "scripts": {
    "build": "npm run build -w @sfx-atelier/web && npm run build -w @sfx-atelier/compare && npm run build -w @sfx-atelier/analysis-demo && node scripts/build-site.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "size": "npm run build -w @sfx-atelier/runtime && node scripts/check-size.mjs",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pack:runtime": "node scripts/pack-runtime.mjs",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "engines": {
    "node": ">=20.12"
  }
}
